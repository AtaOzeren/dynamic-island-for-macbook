{
  "sourceLanguage": "en",
  "strings": {
    "%@ control is off because macOS permission was declined. Everything else in KerNotch keeps working. To turn it on, allow KerNotch for %@ in System Settings › Privacy & Security › Automation.": {
      "comment": "Activities pane, Apple Events row: shown after the user declined the automation prompt. Placeholders are the player name (Spotify, Music).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ control is off because macOS permission was declined. Everything else in KerNotch keeps working. To turn it on, allow KerNotch for %2$@ in System Settings › Privacy & Security › Automation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ denetimi, macOS izni reddedildiği için kapalı. KerNotch'un geri kalanı çalışmayı sürdürüyor. Açmak için Sistem Ayarları › Gizlilik ve Güvenlik › Otomasyon bölümünden KerNotch'a %2$@ izni verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuerung von %1$@ ist aus, weil die macOS-Berechtigung abgelehnt wurde. Alles andere in KerNotch funktioniert weiter. Zum Aktivieren erlaube KerNotch den Zugriff auf %2$@ unter „Systemeinstellungen › Datenschutz & Sicherheit › Automation“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control de %1$@ está desactivado porque se denegó el permiso de macOS. Todo lo demás en KerNotch sigue funcionando. Para activarlo, permite KerNotch para %2$@ en Ajustes del Sistema › Privacidad y seguridad › Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle de %1$@ est désactivé car l'autorisation macOS a été refusée. Tout le reste de KerNotch continue de fonctionner. Pour l'activer, autorisez KerNotch pour %2$@ dans Réglages Système › Confidentialité et sécurité › Automatisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo di %1$@ è disattivato perché l'autorizzazione di macOS è stata negata. Tutto il resto di KerNotch continua a funzionare. Per attivarlo, consenti KerNotch per %2$@ in Impostazioni di Sistema › Privacy e sicurezza › Automazione."
          }
        }
      }
    },
    "A reminder while your microphone is in use.": {
      "comment": "Activities pane: why the microphone recording switch exists.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder while your microphone is in use."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonunuz kullanımdayken bir hatırlatma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hinweis, solange dein Mikrofon benutzt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso mientras se usa tu micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel pendant que votre micro est utilisé."
          }
        },
        "it": {
