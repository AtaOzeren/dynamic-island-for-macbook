          }
        }
      }
    },
    "Open %@ in your editor, creating it if it does not exist.": {
      "comment": "Manual setup sheet, step 1. Placeholder is the absolute path of the agent's configuration file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@ in your editor, creating it if it does not exist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosyasını düzenleyicinizde açın; yoksa oluşturun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne %@ in deinem Editor und lege die Datei an, falls sie nicht existiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre %@ en tu editor y créalo si no existe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez %@ dans votre éditeur, en le créant s'il n'existe pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri %@ nel tuo editor, creandolo se non esiste."
          }
        }
      }
    },
    "Paste the text below as the file's entire contents.": {
      "comment": "Manual setup sheet, step 2 for OpenCode, whose plugin file KerNotch creates outright.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the text below as the file's entire contents."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki metni dosyanın tüm içeriği olarak yapıştırın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den Text unten als gesamten Inhalt der Datei ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el texto de abajo como contenido completo del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le texte ci-dessous comme contenu intégral du fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il testo qui sotto come intero contenuto del file."
          }
        }
      }
    },
    "Replace the file's entire contents with the text below — KerNotch has already merged your existing settings into it.": {
      "comment": "Manual setup sheet, step 2 for Claude Code and Codex, whose existing config KerNotch merged into the snippet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the file's entire contents with the text below — KerNotch has already merged your existing settings into it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyanın tüm içeriğini aşağıdaki metinle değiştirin — KerNotch var olan ayarlarınızı bu metne zaten birleştirdi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze den gesamten Inhalt der Datei durch den Text unten — KerNotch hat deine vorhandenen Einstellungen bereits eingefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye todo el contenido del archivo por el texto de abajo: KerNotch ya ha combinado en él tus ajustes actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez tout le contenu du fichier par le texte ci-dessous — KerNotch y a déjà intégré vos réglages existants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci l'intero contenuto del file con il testo qui sotto: KerNotch vi ha già unito le tue impostazioni esistenti."
          }
        }
      }
    },
    "Save the file, then restart %@ so it picks up the change.": {
      "comment": "Manual setup sheet, final step. Placeholder is the agent name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the file, then restart %@ so it picks up the change."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyayı kaydedin, ardından değişikliği alması için %@ uygulamasını yeniden başlatın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere die Datei und starte %@ neu, damit die Änderung übernommen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el archivo y reinicia %@ para que aplique el cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le fichier, puis redémarrez %@ pour qu'il prenne en compte la modification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il file, poi riavvia %@ così da applicare la modifica."
          }
        }
      }
