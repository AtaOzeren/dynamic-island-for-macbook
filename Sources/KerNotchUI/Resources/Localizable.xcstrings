    "Apple Events, so now playing and playback controls work with Spotify and Apple Music.": {
      "comment": "Onboarding step 2 bullet: what the Apple Events permission buys.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Events, so now playing and playback controls work with Spotify and Apple Music."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Events; böylece şimdi çalan bilgisi ve çalma denetimleri Spotify ve Apple Music ile çalışır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Events, damit „Aktuelle Wiedergabe“ und die Steuerung mit Spotify und Apple Music funktionieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Events, para que la reproducción actual y los controles funcionen con Spotify y Apple Music."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Events, pour que la lecture en cours et les commandes fonctionnent avec Spotify et Apple Music."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Events, così “In riproduzione” e i controlli funzionano con Spotify e Apple Music."
          }
        }
      }
    },
