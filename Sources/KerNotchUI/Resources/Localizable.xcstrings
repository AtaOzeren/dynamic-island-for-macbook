    "Large widens the island that opens on hover and enlarges its text and controls.": {
      "comment": "General pane, Island section caption: what the Large island size changes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large widens the island that opens on hover and enlarges its text and controls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük, üzerine gelince açılan adayı genişletir; yazılarını ve kontrollerini büyütür."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Groß“ verbreitert die Insel, die beim Zeigen aufgeht, und vergrößert Text und Bedienelemente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Grande» ensancha la isla que se abre al pasar el cursor y agranda su texto y sus controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Grand » élargit l'îlot qui s'ouvre au survol et agrandit son texte et ses commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Grande” allarga l'isola che si apre al passaggio del puntatore e ingrandisce testo e controlli."
