    "Automatic follows the display with the notch, then falls back to the built-in screen.": {
      "comment": "General pane, Display section caption.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follows the display with the notch, then falls back to the built-in screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik, çentiği olan ekranı izler; bulamazsa yerleşik ekrana döner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ folgt dem Display mit der Notch und weicht sonst auf den eingebauten Bildschirm aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Automático» sigue la pantalla con muesca y, si no, usa la pantalla integrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Automatique » suit l'écran doté de l'encoche, sinon l'écran intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Automatico” segue il display con il notch, altrimenti usa lo schermo integrato."
          }
        }
      }
    },
