    "Restart KerNotch": {
      "comment": "General pane button that relaunches KerNotch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart KerNotch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KerNotch'u yeniden başlat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KerNotch neu starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar KerNotch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrer KerNotch"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia KerNotch"
          }
        }
      }
    },
    "Restart required": {
      "comment": "Settings warning shown while a change needs an app relaunch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart required"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden başlatma gerekiyor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neustart erforderlich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere reinicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrage requis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvio necessario"
          }
        }
      }
    },
    "Restarts KerNotch without changing your settings.": {
      "comment": "General pane caption for the app restart action when no restart is pending.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restarts KerNotch without changing your settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınızı değiştirmeden KerNotch'u yeniden başlatır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet KerNotch neu, ohne deine Einstellungen zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia KerNotch sin cambiar tus ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarre KerNotch sans modifier vos réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia KerNotch senza modificare le tue impostazioni."
          }
        }
      }
    },
    "Some changes need a restart. Finish your selections, then restart KerNotch.": {
      "comment": "General pane caption shown while a restart-requiring setting is pending.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes need a restart. Finish your selections, then restart KerNotch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı değişiklikler yeniden başlatma gerektiriyor. Seçimlerinizi tamamlayıp KerNotch'u yeniden başlatın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Änderungen erfordern einen Neustart. Triff zuerst deine Auswahl und starte KerNotch dann neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos cambios requieren reiniciar. Termina tus selecciones y reinicia KerNotch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines modifications nécessitent un redémarrage. Terminez vos choix, puis redémarrez KerNotch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune modifiche richiedono un riavvio. Completa le tue scelte, poi riavvia KerNotch."
          }
        }
      }
    },
    "macOS shows this icon on the main menu bar. With multiple displays, it may appear on another screen.": {
      "comment": "General pane hint explaining menu bar icon placement with multiple displays.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS shows this icon on the main menu bar. With multiple displays, it may appear on another screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bu simgeyi ana menü çubuğunda gösterir. Birden fazla ekran varsa başka bir ekranda görünebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zeigt dieses Symbol in der Hauptmenüleiste. Bei mehreren Displays kann es auf einem anderen Bildschirm erscheinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS muestra este icono en la barra de menús principal. Con varias pantallas, puede aparecer en otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS affiche cette icône dans la barre des menus principale. Avec plusieurs écrans, elle peut apparaître sur un autre écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS mostra questa icona nella barra dei menu principale. Con più display può comparire su un altro schermo."
          }
        }
      }
    },
    "A disabled event never reaches the notch — it is dropped on arrival.": {
      "comment": "AI Integrations pane, Events section caption.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A disabled event never reaches the notch — it is dropped on arrival."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatılmış bir olay çentiğe hiç ulaşmaz — geldiği anda düşürülür."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein deaktiviertes Ereignis erreicht die Notch nie — es wird sofort verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento desactivado nunca llega a la muesca: se descarta al llegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un événement désactivé n'atteint jamais l'encoche : il est abandonné dès son arrivée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento disattivato non raggiunge mai il notch: viene scartato all'arrivo."
          }
        }
      }
    },
    "A switched-off activity stops being observed, not just hidden.": {
      "comment": "Activities pane, Activities section caption.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A switched-off activity stops being observed, not just hidden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatılan bir etkinlik yalnızca gizlenmez, izlenmesi de durur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ausgeschaltete Aktivität wird nicht mehr beobachtet, nicht nur ausgeblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una actividad desactivada deja de observarse, no solo de mostrarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une activité désactivée cesse d'être observée, pas seulement masquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'attività disattivata smette di essere osservata, non viene solo nascosta."
          }
        }
      }
    },
