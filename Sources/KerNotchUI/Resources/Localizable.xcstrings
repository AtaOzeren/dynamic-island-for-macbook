    "No agent configuration was found for Claude Code, Codex CLI, or OpenCode. You can install a hook later from Settings once one is set up.": {
      "comment": "Onboarding step 3 body, shown when detection found no agents.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agent configuration was found for Claude Code, Codex CLI, or OpenCode. You can install a hook later from Settings once one is set up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex CLI veya OpenCode için yapılandırma bulunamadı. Birini kurduktan sonra kancayı Ayarlar'dan yükleyebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Claude Code, Codex CLI oder OpenCode wurde keine Konfiguration gefunden. Du kannst einen Hook später in den Einstellungen installieren, sobald einer eingerichtet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró configuración de agente para Claude Code, Codex CLI ni OpenCode. Podrás instalar un hook más adelante desde Ajustes cuando tengas uno configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune configuration d'agent n'a été trouvée pour Claude Code, Codex CLI ou OpenCode. Vous pourrez installer un hook plus tard depuis les réglages, une fois l'un d'eux configuré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stata trovata alcuna configurazione per Claude Code, Codex CLI o OpenCode. Potrai installare un hook più tardi dalle impostazioni, una volta configurato uno di essi."
          }
        }
      }
    },
