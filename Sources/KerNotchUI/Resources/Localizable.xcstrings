    "Connect Discord to see the channel name and leave the channel from the island. Discord asks you to approve KerNotch once.": {
      "comment": "Integrations pane, caption of the Discord connection section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Discord to see the channel name and leave the channel from the island. Discord asks you to approve KerNotch once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal adını görmek ve adadan kanaldan çıkmak için Discord'u bağlayın. Discord, KerNotch'u bir kez onaylamanızı ister."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Discord, um den Kanalnamen zu sehen und den Kanal von der Insel aus zu verlassen. Discord bittet dich einmal, KerNotch zu bestätigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Discord para ver el nombre del canal y salir de él desde la isla. Discord te pide aprobar KerNotch una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Discord pour voir le nom du salon et le quitter depuis l'îlot. Discord vous demande d'approuver KerNotch une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti Discord per vedere il nome del canale e uscirne dall'isola. Discord ti chiede di approvare KerNotch una sola volta."
          }
        }
      }
    },
    "Discord did not recognize KerNotch.": {
      "comment": "Integrations pane status when Discord rejects the build's Discord application.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord did not recognize KerNotch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord KerNotch'u tanımadı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord hat KerNotch nicht erkannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord no reconoció KerNotch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord n'a pas reconnu KerNotch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord non ha riconosciuto KerNotch."
          }
        }
      }
    },
    "Discord did not complete the connection. KerNotch's Discord connection may not be available for your account yet; the microphone badge still works.": {
      "comment": "Integrations pane status when Discord does not complete authorization — before KerNotch's Discord application is approved, accounts that are not its testers see this.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord did not complete the connection. KerNotch's Discord connection may not be available for your account yet; the microphone badge still works."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord bağlantıyı tamamlamadı. KerNotch'un Discord bağlantısı hesabınız için henüz kullanılamıyor olabilir; mikrofon rozeti yine çalışır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord hat die Verbindung nicht abgeschlossen. Die Discord-Verbindung von KerNotch ist für dein Konto vielleicht noch nicht verfügbar; die Mikrofonanzeige funktioniert weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord no completó la conexión. Puede que la conexión de Discord de KerNotch aún no esté disponible para tu cuenta; el indicador del micrófono sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord n'a pas finalisé la connexion. La connexion Discord de KerNotch n'est peut-être pas encore disponible pour votre compte ; l'indicateur du micro fonctionne toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord non ha completato la connessione. La connessione Discord di KerNotch potrebbe non essere ancora disponibile per il tuo account; l'indicatore del microfono continua a funzionare."
          }
        }
      }
    },
