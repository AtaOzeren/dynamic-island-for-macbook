{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ control is off because macOS permission was declined. Everything else in NotchFlow keeps working. To turn it on, allow NotchFlow for %@ in System Settings › Privacy & Security › Automation." : {
      "comment" : "Activities pane, Apple Events row: shown after the user declined the automation prompt. Placeholders are the player name (Spotify, Music).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ control is off because macOS permission was declined. Everything else in NotchFlow keeps working. To turn it on, allow NotchFlow for %2$@ in System Settings › Privacy & Security › Automation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ denetimi, macOS izni reddedildiği için kapalı. NotchFlow'un geri kalanı çalışmayı sürdürüyor. Açmak için Sistem Ayarları › Gizlilik ve Güvenlik › Otomasyon bölümünden NotchFlow'a %2$@ izni verin."
          }
        }
      }
    },
    "A reminder while your microphone is in use." : {
      "comment" : "Activities pane: why the microphone recording switch exists.",
