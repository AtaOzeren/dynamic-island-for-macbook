    },
    "NotchFlow can show and control what %@ is playing." : {
      "comment" : "Activities pane, Apple Events row: shown once permission is granted. Placeholder is the player name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "NotchFlow can show and control what %@ is playing." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "NotchFlow, %@ uygulamasında çalanı gösterebilir ve denetleyebilir." } }
      }
    },
    "NotchFlow could not write this file for you. Copy the text below into %@ to finish setup." : {
      "comment" : "Manual setup sheet subtitle. Placeholder is the absolute path of the agent's configuration file.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchFlow could not write this file for you. Copy the text below into %@ to finish setup."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchFlow bu dosyayı sizin için yazamadı. Kurulumu tamamlamak için aşağıdaki metni %@ dosyasına kopyalayın."
          }
        }
      }
    },
    "NotchFlow will ask macOS for permission to control %@, so the notch can show what is playing and its buttons can control playback. Nothing is sent anywhere; NotchFlow only talks to %@ on this Mac." : {
      "comment" : "Activities pane, Apple Events row: the explanation shown before the macOS prompt. Placeholders are the player name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchFlow will ask macOS for permission to control %1$@, so the notch can show what is playing and its buttons can control playback. Nothing is sent anywhere; NotchFlow only talks to %2$@ on this Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchFlow, %1$@ uygulamasını denetlemek için macOS'ten izin isteyecek; böylece çentik çalanı gösterebilir ve düğmeleri çalmayı denetleyebilir. Hiçbir yere veri gönderilmez; NotchFlow yalnızca bu Mac'teki %2$@ uygulamasıyla konuşur."
          }
        }
      }
    },
    "Now playing, from Apple Music, Spotify, and system media." : {
      "comment" : "Activities pane: why the music switch exists.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Now playing, from Apple Music, Spotify, and system media." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Apple Music, Spotify ve sistem ortamından şimdi çalanlar." } }
      }
    },
    "Open %@" : {
      "comment" : "Expanded activity primary action: brings the source app forward. Placeholder is an app or agent name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open %@" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ uygulamasını aç" } }
      }
    },
    "Open %@ in your editor, creating it if it does not exist." : {
      "comment" : "Manual setup sheet, step 1. Placeholder is the absolute path of the agent's configuration file.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open %@ in your editor, creating it if it does not exist." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ dosyasını düzenleyicinizde açın; yoksa oluşturun." } }
      }
    },
    "Paste the text below as the file's entire contents." : {
      "comment" : "Manual setup sheet, step 2 for OpenCode, whose plugin file NotchFlow creates outright.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Paste the text below as the file's entire contents." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aşağıdaki metni dosyanın tüm içeriği olarak yapıştırın." } }
      }
    },
    "Replace the file's entire contents with the text below — NotchFlow has already merged your existing settings into it." : {
      "comment" : "Manual setup sheet, step 2 for Claude Code and Codex, whose existing config NotchFlow merged into the snippet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
