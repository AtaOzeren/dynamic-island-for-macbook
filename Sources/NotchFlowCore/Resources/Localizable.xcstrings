        "en" : { "stringUnit" : { "state" : "translated", "value" : "A reminder while your microphone is in use." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mikrofonunuz kullanımdayken bir hatırlatma." } }
