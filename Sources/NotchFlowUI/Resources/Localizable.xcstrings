{
  "sourceLanguage": "en",
  "strings": {
    "%lld more activities": {
      "comment": "VoiceOver label for the compact pill's overflow slot, when more activities are running than the pill can show.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more activity"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more activities"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld etkinlik daha"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld etkinlik daha"
                }
              }
            }
          }
        }
      }
    },
    "A disabled event never reaches the notch — it is dropped on arrival.": {
      "comment": "AI Integrations pane, Events section caption.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A disabled event never reaches the notch — it is dropped on arrival."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatılmış bir olay çentiğe hiç ulaşmaz — geldiği anda düşürülür."
          }
        }
      }
    },
    "A switched-off activity stops being observed, not just hidden.": {
      "comment": "Activities pane, Activities section caption.",
      "extractionState": "manual",
